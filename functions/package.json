{
  "name": "wafi-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Wafi Learning Buddy",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "start": "npm run serve",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:emulator": "firebase emulators:exec 'npm test' --only firestore,auth"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "@firebase/rules-unit-testing": "^2.0.0",
    "firebase-tools": "^13.0.0"
  }
}
